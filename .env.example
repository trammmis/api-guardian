# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENAI_API_KEY=""
OPENAI_BASE_URL=https://api.openai.com/v1
DASHSCOPE_API_KEY="your-dashscope-api-key"
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_MODEL=qwen-plus
DEFAULT_LLM_TEMPERATURE=0.2
SESSION_NAMING_ENABLED=false

# MCP 工具配置
# 高德地图 Web 服务 Key（申请：https://lbs.amap.com/dev/key/app）
# 留空则自动禁用高德地图工具集，Agent 仍可正常启动
AMAP_API_KEY="your-amap-api-key"
AMAP_MCP_ENABLED=true
LONG_TERM_MEMORY_MODEL=qwen-plus
LONG_TERM_MEMORY_EMBEDDER_MODEL=text-embedding-v4
LONG_TERM_MEMORY_EMBEDDING_DIMS=1024
LONG_TERM_MEMORY_COLLECTION_NAME=longterm_memory_qwen_1024_v2
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false

# JWT Settings
JWT_SECRET_KEY=""
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=""
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Profiling Settings
PROFILING_DIR=/tmp/fastapi_profiles
PROFILING_THRESHOLD_SECONDS=2.0

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# API Guardian（默认禁止私网 target；本地 fixture 才显式开启）
GUARDIAN_OASDIFF_PATH=oasdiff
GUARDIAN_SCHEMATHESIS_PATH=st
GUARDIAN_ALLOWED_TARGET_HOSTS="api.example.com"
GUARDIAN_ALLOW_PRIVATE_TARGETS=false
GUARDIAN_MAX_OPENAPI_BYTES=5242880
GUARDIAN_MAX_ARTIFACT_BYTES=52428800
GUARDIAN_MAX_SCAN_ARTIFACT_BYTES=104857600
GUARDIAN_SUBPROCESS_TIMEOUT_SECONDS=30
# HTTP 上传后的 durable scan workspace；生产环境应挂载持久化 volume。
GUARDIAN_RUNS_DIR=.guardian_runs
GUARDIAN_LLM_ENABLED=false
GUARDIAN_MAX_RISK_ANALYSES_PER_SCAN=10
GUARDIAN_MAX_FAILURE_DIAGNOSES_PER_SCAN=10
GUARDIAN_ANALYSIS_NODE_TIMEOUT_SECONDS=30
RATE_LIMIT_GUARDIAN_SCAN="5 per hour"
RATE_LIMIT_GUARDIAN_READ="60 per minute"

# Required by the local Grafana service; fill in locally before running Compose.
GRAFANA_PASSWORD=""
